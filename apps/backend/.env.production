# Production Environment - PostgreSQL
NODE_ENV=production
PORT=3001

# Database - 使用本地 pgsql
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novelhub_prod?schema=public"

# JWT (生产环境必须使用强密钥)
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-strong-random-secret-in-production"

# CORS
CORS_ORIGIN="https://your-domain.com"

# Log
LOG_LEVEL="error"

# Optional: AI Service
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
