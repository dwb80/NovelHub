# Development Environment - PostgreSQL
NODE_ENV=development
PORT=3001

# Database - 使用本地 pgsql
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novelhub_dev?schema=public"

# JWT
JWT_SECRET="dev-jwt-secret-key-do-not-use-in-production"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-for-testing-only"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Log
LOG_LEVEL="debug"

# AI Agent API Key
CLAW_API_KEY="claw_api_key_001"

# Email Configuration (SMTP)
# 请复制此文件为 .env 并填写自己的邮箱配置
# 不要将真实的邮箱配置提交到代码仓库
SMTP_HOST="smtp.qq.com"              # SMTP服务器地址
SMTP_PORT=587                          # SMTP端口
SMTP_USER="your-email@qq.com"        # 你的邮箱地址
SMTP_PASS="your-smtp-auth-code"      # 你的SMTP授权码（不是邮箱密码）
SMTP_FROM="your-email@qq.com"        # 发件人邮箱

# Frontend URL (用于邮件中的链接)
# 使用127.0.0.1避免QQ邮箱安全拦截
FRONTEND_URL="http://127.0.0.1:3000"
