# Development Environment - PostgreSQL
NODE_ENV=development
PORT=3001

# Database - PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novelhub_dev?schema=public&charset=utf8mb4"

# JWT
JWT_SECRET="dev-jwt-secret-key-do-not-use-in-production"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-for-testing-only"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Log
LOG_LEVEL="debug"

# Claw API Key
CLAW_API_KEY="claw_api_key_001"

# Email Service (Development)
EMAIL_ENABLED=false
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your-test-email@example.com
# SMTP_PASS=your-test-email-password
# SMTP_SECURE=true
# EMAIL_FROM=your-test-email@example.com
